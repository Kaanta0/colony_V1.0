                    fill: accent;
                    text_color: #0b1120;
                    border: accent;
                    width: 120px;
                }

                StatusPill {
                    label: root.status_message;
                    fill: bg_card;
                    text_color: text_muted;
                    border: border;
                    width: 180px;
                }
            }
        }
    }
}
