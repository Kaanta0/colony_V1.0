import { Button, CheckBox, LineEdit, VerticalBox, HorizontalBox } from "std-widgets.slint";

component AppCard inherits Rectangle {
    in property <string> label;

    height: 64px;
    border-width: 1px;
    border-color: #1f2937;
    border-radius: 10px;
    background: #111827;

    Text {
        text: label;
        color: #e2e8f0;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
}

export component AppWindow inherits Window {
    title: "Colony";
    width: 900px;
    height: 600px;
    background: #0b1120;

    in-out property <[string]> repositories;
    in-out property <[string]> scan_paths;
    in-out property <string> status_message;

    callback rescan();

    VerticalBox {
        spacing: 18px;
        padding: 24px;

        Rectangle {
            height: 56px;
            border-width: 1px;
            border-color: #1f2937;
            border-radius: 14px;
            background: #111827;

            HorizontalBox {
                spacing: 16px;
                padding: 12px;

                LineEdit {
                    width: 220px;
                    placeholder-text: "Search";
                }

                Text {
                    text: "— Apps —";
                    color: #cbd5f5;
                    vertical-alignment: center;
                }

                HorizontalBox {
                    spacing: 8px;
                    Text {
                        text: "Quick Actions";
                        color: #cbd5f5;
                        vertical-alignment: center;
                    }
                    Button {
                        text: "Rescan";
                        clicked => {
                            root.rescan();
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                Text {
                    text: "12:42 UTC";
                    color: #cbd5f5;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalBox {
            spacing: 18px;

            Rectangle {
                width: 220px;
                border-width: 1px;
                border-color: #1f2937;
                border-radius: 14px;
                background: #0f172a;

                VerticalBox {
                    spacing: 12px;
                    padding: 16px;

                    Text {
                        text: "FILTERS";
                        color: #e2e8f0;
                        font-weight: 700;
                    }

                    Rectangle {
                        height: 1px;
                        background: #1f2937;
                    }

                    CheckBox {
                        text: "All Apps";
                        checked: true;
                    }
                    CheckBox {
                        text: "Navigation";
                    }
                    CheckBox {
                        text: "Control";
                    }
                    CheckBox {
                        text: "Sensors";
                    }
                    CheckBox {
                        text: "Systems";
                    }
                }
            }

            Rectangle {
                border-width: 1px;
                border-color: #1f2937;
                border-radius: 14px;
                background: #0f172a;
                horizontal-stretch: 1;

                VerticalBox {
                    spacing: 12px;
                    padding: 16px;

                    Text {
                        text: "CARD VIEW / GRID";
                        color: #e2e8f0;
                        font-weight: 700;
                    }

                    Rectangle {
                        height: 1px;
                        background: #1f2937;
                    }

                    HorizontalBox {
                        spacing: 12px;
                        AppCard { label: "ECDIS"; }
                        AppCard { label: "Radar"; }
                        AppCard { label: "Conning"; }
                    }

                    HorizontalBox {
                        spacing: 12px;
                        AppCard { label: "Nav St."; }
                        AppCard { label: "Speed Log"; }
                        AppCard { label: "DP"; }
                    }

                    HorizontalBox {
                        spacing: 12px;
                        AppCard { label: "Thruster"; }
                        AppCard { label: "Joystick"; }
                        AppCard { label: "Echo"; }
                    }

                    HorizontalBox {
                        spacing: 12px;
                        AppCard { label: "Lights"; }
                        AppCard { label: "Screen Ctrl"; }
                        AppCard { label: "Sys"; }
                    }
                }
            }
        }

        Rectangle {
            height: 66px;
            border-width: 1px;
            border-color: #1f2937;
            border-radius: 14px;
            background: #111827;

            VerticalBox {
                spacing: 6px;
                padding: 12px;

                Text {
                    text: "↑ Recommended for you: Radar, DP, Thruster";
                    color: #cbd5f5;
                }

                HorizontalBox {
                    spacing: 12px;

                    Text {
                        text: "● Active: Online";
                        color: #cbd5f5;
                    }

                    Text {
                        text: "•";
                        color: #475569;
                    }

                    Text {
                        text: "⚙ Settings";
                        color: #cbd5f5;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;
                    }

                    Text {
                        text: root.status_message;
                        color: #94a3b8;
                    }
                }
            }
        }
    }
}
