import { LineEdit, VerticalBox, HorizontalBox } from "std-widgets.slint";

component AppSurface inherits Rectangle {
    in property <color> fill;
    in property <color> stroke;
    in property <length> radius;
    in property <length> shadow_blur;
    in property <length> shadow_offset;
    in property <color> shadow_color;

    background: fill;
    border-width: 1px;
    border-color: stroke;
    border-radius: radius;
    drop-shadow-blur: shadow_blur;
    drop-shadow-offset-y: shadow_offset;
    drop-shadow-color: shadow_color;
}

component SectionTitle inherits Text {
    in property <color> title_color;
    in property <length> size;

    font-size: size;
    font-weight: 700;
    color: title_color;
}

component PrimaryButton inherits Rectangle {
    in property <string> label;
    in property <color> fill;
    in property <color> label_color;
    in property <color> hover_fill;
    in property <color> pressed_fill;
    in property <color> stroke_color;
    in property <length> radius;
    in property <length> label_size;
    callback clicked();

    background: fill;
    border-radius: radius;
    border-width: 1px;
    border-color: root.stroke_color;
    padding: 10px;

    button_touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    states [
        hovered when button_touch.has_hover : {
            background: hover_fill;
        }
        pressed when button_touch.pressed : {
            background: pressed_fill;
        }
    ]

    Text {
        text: root.label;
        color: root.label_color;
        font-size: root.label_size;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
}

component SecondaryButton inherits Rectangle {
    in property <string> label;
    in property <color> fill;
    in property <color> label_color;
    in property <color> hover_fill;
    in property <color> pressed_fill;
    in property <color> stroke_color;
    in property <length> radius;
    in property <length> label_size;
    callback clicked();

    background: fill;
    border-radius: radius;
    border-width: 1px;
    border-color: root.stroke_color;
    padding: 10px;

    button_touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    states [
        hovered when button_touch.has_hover : {
            background: hover_fill;
        }
        pressed when button_touch.pressed : {
            background: pressed_fill;
        }
    ]

    Text {
        text: root.label;
        color: root.label_color;
        font-size: root.label_size;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
}

component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <color> fill;
    in property <color> border;
    in property <color> focus_border;
    in property <length> radius;
    in property <string> placeholder;
    in property <length> font_size;

    background: fill;
    border-width: 1px;
    border-color: border;
    border-radius: radius;
    padding: 4px;

    states [
        focused when input.has-focus : {
            border-color: focus_border;
        }
    ]

    input := LineEdit {
        text <=> root.text;
        placeholder-text: root.placeholder;
        font-size: root.font_size;
    }
}

component FilterItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <color> text_color;
    in property <color> active_color;
    in property <color> hover_color;
    in property <color> indicator_fill;
    in property <color> indicator_border;
    in property <length> indicator_radius;
    property <color> current_color: root.active ? active_color : text_color;

    background: transparent;
    height: 24px;

    touch := TouchArea {}

    states [
        hovered when touch.has_hover : {
            current_color: hover_color;
        }
        active when root.active : {
            current_color: active_color;
        }
    ]

    HorizontalBox {
        spacing: 8px;

        Rectangle {
            width: 16px;
            height: 16px;
            border-radius: indicator_radius;
            background: indicator_fill;
            border-width: 1px;
            border-color: indicator_border;

            Text {
                text: root.active ? "✓" : "";
                color: root.current_color;
                font-size: 10px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }

        Text {
            text: root.label;
            color: root.current_color;
            font-size: 13px;
        }
    }
}

component Tag inherits Rectangle {
    in property <string> label;
    in property <color> fill;
    in property <color> text_color;
    in property <color> border;

    height: 22px;
    border-radius: 999px;
    border-width: 1px;
    border-color: border;
    background: fill;

    Text {
        text: label;
        color: text_color;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
}

component StatusPill inherits Rectangle {
    in property <string> label;
    in property <color> fill;
    in property <color> text_color;
    in property <color> border;

    height: 22px;
    border-radius: 999px;
    border-width: 1px;
    border-color: border;
    background: fill;

    Text {
        text: label;
        color: text_color;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
}

component AppCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> status;
    in property <string> icon;
    in property <color> fill;
    in property <color> hover_fill;
    in property <color> border;
    in property <color> accent;
    in property <color> text_primary;
    in property <color> text_secondary;
    in property <length> shadow_blur;
    in property <length> shadow_offset;
    in property <color> shadow_color;
    in property <length> shadow_hover_blur;
    in property <length> shadow_hover_offset;
    in property <color> shadow_hover_color;

    height: 108px;
    width: 180px;
    background: fill;
    border-width: 1px;
    border-color: border;
    border-radius: 16px;
    drop-shadow-blur: shadow_blur;
    drop-shadow-offset-y: shadow_offset;
    drop-shadow-color: shadow_color;

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
    }

    states [
        hovered when touch.has_hover : {
            background: hover_fill;
            border-color: accent;
            drop-shadow-blur: shadow_hover_blur;
            drop-shadow-offset-y: shadow_hover_offset;
            drop-shadow-color: shadow_hover_color;
        }
        pressed when touch.pressed : {
            background: hover_fill;
            border-color: accent;
            drop-shadow-blur: shadow_hover_blur;
            drop-shadow-offset-y: shadow_hover_offset;
            drop-shadow-color: shadow_hover_color;
        }
    ]

    HorizontalBox {
        spacing: 12px;
        padding: 14px;

        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: accent;
            opacity: 0.14;

            Text {
                text: icon;
                color: accent;
                font-size: 18px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }

        VerticalBox {
            spacing: 4px;

            Text {
                text: title;
                color: text_primary;
                font-size: 14px;
                font-weight: 700;
            }

            Text {
                text: subtitle;
                color: text_secondary;
                font-size: 12px;
            }

            StatusPill {
                label: status;
                fill: accent;
                text_color: text_primary;
                border: accent;
                width: 78px;
            }
        }
    }
}

export component AppWindow inherits Window {
