    property <color> bg_card: #111827;
    property <color> border: #1e293b;
    property <color> accent: #38bdf8;
    property <color> text_primary: #f8fafc;
    property <color> text_secondary: #cbd5f5;
    property <color> text_muted: #94a3b8;

    property <length> title_size: 20px;
    property <length> section_size: 16px;
    property <length> body_size: 14px;
    property <length> meta_size: 12px;

    property <length> space_1: 4px;
    property <length> space_2: 8px;
    property <length> space_3: 12px;
    property <length> space_4: 16px;
    property <length> space_5: 20px;
    property <length> space_6: 24px;

    property <length> radius_sm: 10px;
    property <length> radius_md: 14px;
    property <length> radius_lg: 18px;

    property <shadow> shadow_sm: {
        color: #02061755;
        offset-x: 0px;
        offset-y: 4px;
        blur: 12px;
