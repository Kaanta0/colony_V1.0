import { Button, CheckBox, LineEdit, TouchArea, VerticalBox, HorizontalBox } from "std-widgets.slint";

component AppSurface inherits Rectangle {
    in property <color> fill;
    in property <color> stroke;
    in property <length> radius;
    in property <shadow> shadow;

    background: fill;
    border-width: 1px;
    border-color: stroke;
    border-radius: radius;
    drop-shadow: shadow;
}

component SectionTitle inherits Text {
    in property <color> color;
    in property <length> size;

    font-size: size;
    font-weight: 700;
    color: color;
}

component PrimaryButton inherits Button {
    in property <color> fill;
    in property <color> text_color;
    in property <color> hover_fill;
    in property <color> pressed_fill;
    in property <color> border;

    background: fill;
    color: text_color;
    border-radius: 12px;
    border-width: 1px;
    border-color: border;
    font-size: 13px;
    padding: 10px 16px;

    states [
        hovered when root.has-hover {
            background: hover_fill;
        }
        pressed when root.pressed {
            background: pressed_fill;
        }
    ]
}

component SecondaryButton inherits Button {
    in property <color> fill;
    in property <color> text_color;
    in property <color> hover_fill;
    in property <color> pressed_fill;
    in property <color> border;

    background: fill;
    color: text_color;
    border-radius: 12px;
    border-width: 1px;
    border-color: border;
    font-size: 13px;
    padding: 10px 16px;

    states [
        hovered when root.has-hover {
            background: hover_fill;
        }
        pressed when root.pressed {
            background: pressed_fill;
        }
    ]
}

component SearchField inherits LineEdit {
    in property <color> fill;
    in property <color> text_color;
    in property <color> placeholder_color;
    in property <color> border;
    in property <color> focus_border;

    background: fill;
    color: text_color;
    border-width: 1px;
    border-color: border;
    border-radius: 12px;
    padding: 10px 14px;
    font-size: 13px;
    placeholder-text-color: placeholder_color;

    states [
        focused when root.has-focus {
            border-color: focus_border;
        }
    ]
}

component FilterCheck inherits CheckBox {
    in property <color> text_color;
    in property <color> active_color;
    in property <color> hover_color;

    color: text_color;
    font-size: 13px;

    states [
        hovered when root.has-hover {
            color: hover_color;
        }
        active when root.checked {
            color: active_color;
        }
    ]
}

component Tag inherits Rectangle {
    in property <string> label;
    in property <color> fill;
    in property <color> text_color;
    in property <color> border;

    height: 22px;
    border-radius: 999px;
    border-width: 1px;
    border-color: border;
    background: fill;

    Text {
        text: label;
        color: text_color;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
}

component StatusPill inherits Rectangle {
    in property <string> label;
    in property <color> fill;
    in property <color> text_color;
    in property <color> border;

    height: 22px;
    border-radius: 999px;
    border-width: 1px;
    border-color: border;
    background: fill;

    Text {
        text: label;
        color: text_color;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
}

component AppCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> status;
    in property <string> icon;
    in property <color> fill;
    in property <color> hover_fill;
    in property <color> border;
    in property <color> accent;
    in property <color> text_primary;
    in property <color> text_secondary;
    in property <shadow> shadow;
    in property <shadow> shadow_hover;

    height: 108px;
    width: 180px;
    background: fill;
    border-width: 1px;
    border-color: border;
    border-radius: 16px;
    drop-shadow: shadow;

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
    }

    states [
        hovered when touch.has-hover {
            background: hover_fill;
            border-color: accent;
            drop-shadow: shadow_hover;
        }
        pressed when touch.pressed {
            background: hover_fill;
            border-color: accent;
            drop-shadow: shadow_hover;
        }
    ]

    HorizontalBox {
        spacing: 12px;
        padding: 14px;

        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: accent;
            opacity: 0.14;

            Text {
                text: icon;
                color: accent;
                font-size: 18px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }

        VerticalBox {
            spacing: 4px;

            Text {
                text: title;
                color: text_primary;
                font-size: 14px;
                font-weight: 700;
            }

            Text {
                text: subtitle;
                color: text_secondary;
                font-size: 12px;
            }

            StatusPill {
                label: status;
                fill: accent;
                text_color: text_primary;
                border: accent;
                width: 78px;
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Colony";
    width: 980px;
    height: 640px;

    property <color> bg_main: #0b1120;
